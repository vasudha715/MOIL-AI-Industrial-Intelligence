# Copy this file to .env and fill in real values before running.

# Generate a strong random value for real deployment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_SECRET_BEFORE_DEPLOYMENT

# SQLite by default. For Postgres, use something like:
#   postgresql://user:password@host:5432/moil_ai
DATABASE_URL=sqlite:///./moil_ai.db

# Comma-separated extra origins allowed to call the API (your deployed frontend URL)
EXTRA_CORS_ORIGINS=
